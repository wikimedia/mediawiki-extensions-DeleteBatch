{
	"name": "DeleteBatch",
	"version": "1.8.1",
	"author": [
		"Bartek Łapiński",
		"..."
	],
	"url": "https://www.mediawiki.org/wiki/Extension:DeleteBatch",
	"descriptionmsg": "deletebatch-desc",
	"namemsg": "deletebatch-extensionname",
	"license-name": "GPL-2.0-or-later",
	"requires": {
		"MediaWiki": ">= 1.46.0"
	},
	"type": "specialpage",
	"ReservedUsernames": [
		"msg:deletebatch-system-username"
	],
	"AvailableRights": [
		"deletebatch",
		"deletebatch-spoof"
	],
	"GroupPermissions": {
		"bureaucrat": {
			"deletebatch": true,
			"deletebatch-spoof": true
		}
	},
	"SpecialPages": {
		"DeleteBatch": {
			"class": "MediaWiki\\Extension\\DeleteBatch\\SpecialDeleteBatch",
			"services": [
				"ConnectionProvider",
				"DBLoadBalancerFactory",
				"LinkRenderer",
				"RepoGroup",
				"UserFactory",
				"WikiPageFactory"
			]
		}
	},
	"MessagesDirs": {
		"DeleteBatch": [
			"i18n"
		]
	},
	"ExtensionMessagesFiles": {
		"DeleteBatchAlias": "DeleteBatch.alias.php"
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\DeleteBatch\\": "includes/"
	},
	"HookHandlers": {
		"main": {
			"class": "MediaWiki\\Extension\\DeleteBatch\\Hooks"
		}
	},
	"Hooks": {
		"AdminLinks": "main"
	},
	"manifest_version": 1
}
